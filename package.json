{
  "name": "anystream",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AnyStream \u2014 a YouTube-inspired, fully client-side live IPTV browser powered by the public iptv-org API.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "verify:pipeline": "esbuild scripts/verify-pipeline.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=scripts/.verify/pipeline.mjs --log-level=error && node scripts/.verify/pipeline.mjs",
    "verify:render": "esbuild scripts/verify-render.tsx --bundle --platform=node --format=cjs --packages=external --alias:@=./src --outfile=scripts/.verify/render.cjs --jsx=automatic --log-level=error && node scripts/.verify/render.cjs",
    "verify:fallback": "esbuild scripts/verify-fallback.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=scripts/.verify/fallback.mjs --log-level=error && node scripts/.verify/fallback.mjs",
    "snapshot": "node scripts/build-fallback-snapshot.mjs"
  },
  "dependencies": {
    "hls.js": "^1.5.20",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "jsdom": "^31.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
